# SPDX-License-Identifier: MIT
# Production-shaped environment template. No credentials here.
# Create .env.prod using setup-prod.sh; never commit .env.prod.

# Versioned production release image; no local Rust build required.
# Update this tag only after its Docker Hub release has passed CI.
ENGY_APP_IMAGE=docker.io/pmelendez2/gb-energy-ingest:0.1.0
ENGY_DB_IMAGE=mariadb:lts
ENGY_DB_NAME=energy_ingest
ENGY_DB_USER=energy_ingest

ENGY_DB_PWD_FILE=./prod-secrets/energy_db_pwd
ENGY_DB_ROOT_PWD_FILE=./prod-secrets/energy_db_root_pwd

# Optional: absolute path or path relative to deploy/docker-compose.
# ENGY_IMPORT_DIR=./private-imports

# API starts automatically with setup-prod.sh.
# Loopback remains available for local administration.
# Set LAN IP to enable direct Home Assistant access.
# ENGY_API_LAN_BIND_IP=192.168.1.115
# Do not forward this HTTP port from the router.
# Default port published only on host loopback.
ENGY_API_BIND_IP=127.0.0.1
ENGY_API_PORT=8080

# Optional: validated local daily gas reporting convention.
# Only enable after confirming meter 2 really uses this time zone.
# ENGY_GAS_DAILY_ZONE_METER_2=America/Los_Angeles
