# SPDX-License-Identifier: MIT
# Production-shaped environment template. No credentials here.
# Create .env.prod using setup-prod.sh; never commit .env.prod.

ENGY_DB_IMAGE=mariadb:lts
ENGY_DB_NAME=energy_ingest
ENGY_DB_USER=energy_ingest

ENGY_DB_PWD_FILE=./prod-secrets/energy_db_pwd
ENGY_DB_ROOT_PWD_FILE=./prod-secrets/energy_db_root_pwd

# Optional: absolute path or path relative to deploy/docker-compose.
# ENGY_IMPORT_DIR=./private-imports

# API is opt-in: docker compose --profile api up -d api
# Default port published only on host loopback.
ENGY_API_BIND_IP=127.0.0.1
ENGY_API_PORT=8080
