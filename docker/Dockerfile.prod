# SPDX-License-Identifier: MIT

FROM rust:1-bookworm AS builder

WORKDIR /workspace

COPY . .

RUN cargo build \
    --locked \
    --release \
    -p energy-store \
    --bin energy-store-admin \
    --bin energy-store-import \
    --bin energy-api-token \
    -p energy-api \
    --bin energy-api

FROM debian:bookworm-slim

# Runtime account identity
ARG ENGY_RUN_USER=energy
ARG ENGY_RUN_GROUP=energy
ARG ENGY_RUN_UID=10001
ARG ENGY_RUN_GID=10001

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        gosu \
        perl-base \
    && groupadd  \
        --gid "${ENGY_RUN_GID}" \
        "${ENGY_RUN_GROUP}" \
    && useradd \
        --uid "${ENGY_RUN_UID}" \
        --gid "${ENGY_RUN_GROUP}" \
        --home-dir /var/lib/energy-ingest \
        --create-home \
        --shell /usr/sbin/nologin \
        "${ENGY_RUN_USER}" \
    && rm -rf /var/lib/apt/lists/*

ENV ENGY_RUN_USER=${ENGY_RUN_USER}
ENV ENGY_RUN_GROUP=${ENGY_RUN_GROUP}

WORKDIR /var/lib/energy-ingest

COPY --from=builder \
    /workspace/target/release/energy-store-admin \
    /usr/local/bin/energy-store-admin

COPY --from=builder \
    /workspace/target/release/energy-store-import \
    /usr/local/bin/energy-store-import

COPY --from=builder \
    /workspace/target/release/energy-api-token \
    /usr/local/bin/energy-api-token

COPY --from=builder \
    /workspace/target/release/energy-api \
    /usr/local/bin/energy-api

COPY docker/engy-api-prod-ep.sh \
    /usr/local/bin/engy-api-prod-ep

COPY docker/engy-st-imp-prod-ep.sh \
    /usr/local/bin/engy-st-imp-prod-ep

COPY docker/es-adm-prod.sh \
    /usr/local/bin/es-adm-prod

RUN chmod 0755 \
    /usr/local/bin/energy-store-admin \
    /usr/local/bin/energy-store-import \
    /usr/local/bin/energy-api-token \
    /usr/local/bin/energy-api \
    /usr/local/bin/engy-api-prod-ep \
    /usr/local/bin/engy-st-imp-prod-ep \
    /usr/local/bin/es-adm-prod

ENTRYPOINT ["/usr/local/bin/es-adm-prod"]
