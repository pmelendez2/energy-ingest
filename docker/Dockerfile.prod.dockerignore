# Production image build context.
.git
.gitignore
target
**/target

deploy/docker-compose/.env*
deploy/docker-compose/dev-secrets
deploy/docker-compose/prod-secrets
deploy/docker-compose/*.zip

.test-status.md
.test-history.csv

docker/Dockerfile.dev
deploy/docker-compose/compose.dev.yml
deploy/docker-compose/compose.test.yml
deploy/docker-compose/setup-dev.sh
deploy/docker-compose/status-dev.sh
deploy/docker-compose/dev.sh
deploy/docker-compose/test.sh

# Customer data and any local import/backup material.
**/*.xml
**/*.csv
**/*.sqlite
**/*.sqlite3
**/*.db
**/*.zip
**/*.tar
**/*.tar.gz
**/private/**
**/private-imports/**
**/secrets/**
**/prod-secrets/**
**/dev-secrets/**
**/backup/**
**/backups/**

# Credentials and host-specific state, regardless of directory.
**/.env
**/.env.*
**/*.age
**/*.sops.*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/id_rsa
**/id_ed25519
**/.ssh/**
**/.git/**
**/__pycache__/**
**/.venv/**
**/.pytest_cache/**
**/coverage/**
**/test-output/**
